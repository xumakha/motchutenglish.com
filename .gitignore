# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tests
/playwright-report
/test-results

# runtime files (media, exports, mail log, local credentials)
/writable

# Bundled worker (pnpm build:worker)
/dist/

# Agent worktrees and local tools
/.claude/worktrees/
/.tools/

# Local files left from the PHP app (database credentials); the app itself is at tag php-final
/application/
