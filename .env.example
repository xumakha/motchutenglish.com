# PHP reads process environment. This template is NOT automatically loaded.
APP_ENV=development
APP_URL=http://localhost:8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=motchutenglish
DB_USER=mce
DB_PASSWORD=
SESSION_SECURE=0
# disabled | log (development/test only) | smtp
MAIL_DRIVER=disabled
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USER=
SMTP_PASSWORD=
MEDIA_DRIVER=local
# Both empty keeps external analytics disabled, even after consent.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Optional absolute binaries, e.g. C:\xampp\mysql\bin\mysqldump.exe
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql
# Docker Compose only; use independent generated secrets.
MCE_DB_PASSWORD=
MCE_DB_ROOT_PASSWORD=
